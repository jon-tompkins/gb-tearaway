# Auth.js (NextAuth v5) — Google sign-in
# Copy to .env.local for local dev, and set the same vars in Vercel → Settings → Environment Variables.

# Any long random string. Generate with:  npx auth secret
AUTH_SECRET=

# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (type: Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Authorized redirect URIs to add on that Google OAuth client:
#   https://backofthebox.xyz/api/auth/callback/google
#   https://<your-app>.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
#
# trustHost is enabled, so the callback works on whatever domain serves the
# request — no AUTH_URL needed. Set AUTH_URL=https://backofthebox.xyz only if
# you want to force it.

# --- Persistence (Supabase) ---
# Without these, dispatches are stored per-user in an ephemeral file (fine for
# local dev, but Vercel's serverless disk resets — data won't survive). Set both
# to persist durably in Supabase (one row per user in the botb_state table).
#   SUPABASE_URL: project URL, e.g. https://xxxx.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY: service_role key (server-only — never expose client-side)
# One-time table setup (Supabase SQL editor): see db/botb_state.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Real news (optional) ---
# Without this, the News modules use the built-in curated story bank. With an
# Anthropic API key set, News pulls today's real RSS headlines and rewrites them
# into kid-safe, age-appropriate blurbs with Haiku (cached once per day per feed
# in the same store). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# --- Email delivery (Resend) ---
# Sends each dispatch as an "open today's paper" email at its delivery time
# (hourly Vercel cron at /api/cron/send). Verify backofthebox.xyz in Resend and
# add the DNS records it gives you, then set:
RESEND_API_KEY=
# From address on a verified domain (defaults to digest@backofthebox.xyz):
EMAIL_FROM="Back of the Box <digest@backofthebox.xyz>"
# Public base URL used in email links (defaults to https://www.backofthebox.xyz):
EMAIL_SITE_URL=
# Shared secret protecting the cron endpoint (Vercel Cron sends it automatically):
CRON_SECRET=

# Optional: TheSportsDB API key for the Sports module (defaults to the free "3" test key)
SPORTSDB_KEY=3

# --- Payments (Stripe) ---
# First month free, then $20/yr or $6/qtr (up to 2 kids), $40/yr or $12/qtr (up to 5). Until STRIPE_SECRET_KEY is set nothing is
# enforced (no way to pay yet), so lapsed trials keep getting pages.
#   STRIPE_SECRET_KEY: Stripe → Developers → API keys (sk_test_… first, then sk_live_…)
#   STRIPE_WEBHOOK_SECRET: Stripe → Developers → Webhooks → add endpoint
#     https://www.backofthebox.xyz/api/billing/webhook with events
#     checkout.session.completed, customer.subscription.created/updated/deleted
#   STRIPE_PRICE_ID_KIDS2_YEAR / _KIDS2_QUARTER / _KIDS5_YEAR / _KIDS5_QUARTER (optional):
#     pre-made prices; without them Checkout makes each one inline from src/lib/plans.ts.
# Also save the Customer Portal settings once (Settings → Billing → Customer portal)
# so "Manage billing" works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
